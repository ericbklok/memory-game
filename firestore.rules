rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: validate bounded, tamper-resistant leaderboard entry
    function isValidLeaderboardDoc(uid) {
      let d = request.resource.data;
      return request.auth != null
        && request.auth.uid == uid
        && d.keys().hasOnly([
          'uid', 'displayName', 'avatar', 'homeBadge',
          'totalPoints', 'todayPoints', 'todayDate',
          'streak', 'circles', 'updatedAt'
        ])
        && d.uid == uid
        && d.displayName is string
        && d.displayName.size() >= 1
        && d.displayName.size() <= 24
        && d.avatar is string
        && d.avatar.size() <= 8
        && d.homeBadge is string
        && d.homeBadge.size() <= 8
        && d.totalPoints is int
        && d.totalPoints >= 0
        && d.totalPoints <= 2000000
        && d.todayPoints is int
        && d.todayPoints >= 0
        && d.todayPoints <= 50000
        && d.todayDate is string
        && d.todayDate.size() == 10
        && d.streak is int
        && d.streak >= 0
        && d.streak <= 3650
        && d.circles is list
        && d.circles.size() <= 10
        // Prevent massive single-write score jumps (max +2500 pts per sync above previous total)
        && (
          resource == null ||
          (d.totalPoints >= resource.data.totalPoints && d.totalPoints <= resource.data.totalPoints + 2500)
        );
    }

    // Public read so anyone can admire the Global & Family Circle Leaderboard;
    // strict per-user OAuth write isolation & validation!
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if isValidLeaderboardDoc(uid);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
