rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: leaderboard
// Document ID: {uid} (must match authenticated user's request.auth.uid)
// Fields (10 required core fields + 1 optional presence field; no extraneous fields permitted):
//   - uid: string (required, immutable, 1..128 chars, == request.auth.uid) - Owner UID
//   - displayName: string (required, 1..24 chars, no HTML chars <>&"' or newlines) - Public player nickname
//   - avatar: string (required, 1..8 chars, enum of 8 app emojis) - Chosen tea-house avatar
//   - homeBadge: string (required, 1..8 chars, enum of 3 regional flags) - HK / YVR / Both badge
//   - totalPoints: int (required, 0..2000000; create <= 15000; update monotonic +0..+1000) - Cumulative score
//   - todayPoints: int (required, 0..5000) - Score earned on todayDate
//   - todayDate: string (required, 10 chars, YYYY-MM-DD) - Local calendar date string
//   - streak: int (required, 0..3650; create <= 90; update <= resource.data.streak + 2) - Daily play streak
//   - circles: list<string> (required, max 10 items, each 3..16 chars matching ^[A-Z0-9-]+$) - Circle codes
//   - updatedAt: timestamp (required, must equal request.time via serverTimestamp()) - Server sync / last-played timestamp
//   - activeGame: string (optional, 0..16 chars, strict enum of '' or one of the 26 game IDs) - Live currently-playing game ID
//
// Collection: pushReminders
// Document ID: {uid} (must match authenticated user's request.auth.uid)
// Fields (all 8 required on create & update; zero extraneous fields, zero PII, zero plaintext push URLs):
//   - uid: string (required, immutable, 1..128 chars, == request.auth.uid) - Owner UID
//   - enabled: bool (required) - Whether daily Web Push reminder is active
//   - sealedSub: string (required, base64url ^[A-Za-z0-9_-]*$; 120..1024 chars when enabled == true, '' when enabled == false)
//       Holds ECDH-P256 + AES-256-GCM encrypted PushSubscription ciphertext (decryptable only via private key in GitHub Secrets)
//   - lang: string (required, enum ['zh', 'en']) - Preferred notification language
//   - region: string (required, enum ['hk', 'yvr', 'both']) - Preferred timezone/region schedule
//   - reminderHour: int (required, 0..23) - Preferred local hour for daily reminder
//   - lastDoneDate: string (required, '' or 10-char YYYY-MM-DD) - Last completed daily-set date to suppress duplicate reminders
//   - updatedAt: timestamp (required, must equal request.time via serverTimestamp()) - Server sync timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource != null && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return 'uid' in request.resource.data && request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return 'uid' in request.resource.data && request.resource.data.uid == resource.data.uid;
    }

    function leaderboardRequiredKeys() {
      return [
        'uid',
        'displayName',
        'avatar',
        'homeBadge',
        'totalPoints',
        'todayPoints',
        'todayDate',
        'streak',
        'circles',
        'updatedAt'
      ];
    }

    function leaderboardAllowedKeys() {
      return [
        'uid',
        'displayName',
        'avatar',
        'homeBadge',
        'totalPoints',
        'todayPoints',
        'todayDate',
        'streak',
        'circles',
        'updatedAt',
        'activeGame'
      ];
    }

    function pushReminderKeys() {
      return [
        'uid',
        'enabled',
        'sealedSub',
        'lang',
        'region',
        'reminderHour',
        'lastDoneDate',
        'updatedAt'
      ];
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidCircleCode(code) {
      return code is string
        && code.size() >= 3
        && code.size() <= 16
        && code.matches('^[A-Z0-9-]+$');
    }

    // Deep array inspection: enforce list type, max 10 items, and validate every element (indices 0..9)
    function isValidCirclesList(circles) {
      return circles is list
        && circles.size() <= 10
        && (circles.size() < 1 || isValidCircleCode(circles[0]))
        && (circles.size() < 2 || isValidCircleCode(circles[1]))
        && (circles.size() < 3 || isValidCircleCode(circles[2]))
        && (circles.size() < 4 || isValidCircleCode(circles[3]))
        && (circles.size() < 5 || isValidCircleCode(circles[4]))
        && (circles.size() < 6 || isValidCircleCode(circles[5]))
        && (circles.size() < 7 || isValidCircleCode(circles[6]))
        && (circles.size() < 8 || isValidCircleCode(circles[7]))
        && (circles.size() < 9 || isValidCircleCode(circles[8]))
        && (circles.size() < 10 || isValidCircleCode(circles[9]));
    }

    // Optional live-presence game ID validator (strict enum whitelist + size bound)
    function isValidOptionalActiveGame(d) {
      return !('activeGame' in d) || (
        d.activeGame is string
        && d.activeGame.size() <= 16
        && d.activeGame in [
          '',
          'news',
          'memory',
          'math',
          'history',
          'words',
          'eagle',
          'sudoku',
          'tenpai',
          'shisen',
          'make24',
          'wordsearch',
          'blocks',
          'stroop',
          'melody',
          'vocab',
          'spotdiff',
          'headcount',
          'balance',
          'steamer',
          'quicksign',
          'clocktower',
          'trail',
          'tangram',
          'spotlight',
          'radicals',
          'cupshuffle'
        ]
      );
    }

    // ===============================================================
    // Domain Validators: leaderboard (Used in BOTH create and update)
    // ===============================================================

    function isValidLeaderboardBase(uid) {
      let d = request.resource.data;
      return isOwner(uid)
        && uidUnchanged()
        && hasRequiredFields(leaderboardRequiredKeys())
        && hasOnlyAllowedFields(leaderboardAllowedKeys())
        && d.uid is string
        && d.uid.size() >= 1
        && d.uid.size() <= 128
        && d.uid == uid
        && d.displayName is string
        && d.displayName.size() >= 1
        && d.displayName.size() <= 24
        && d.displayName.matches("^[^<>&\"'\\r\\n]+$")
        && d.avatar is string
        && d.avatar.size() >= 1
        && d.avatar.size() <= 8
        && d.avatar in ['🫖', '🥟', '🀄', '🌺', '🦁', '🍁', '⛴️', '🐼']
        && d.homeBadge is string
        && d.homeBadge.size() >= 1
        && d.homeBadge.size() <= 8
        && d.homeBadge in ['🇭🇰', '🇨🇦', '🌏']
        && d.totalPoints is int
        && d.totalPoints >= 0
        && d.totalPoints <= 2000000
        && d.todayPoints is int
        && d.todayPoints >= 0
        && d.todayPoints <= 5000
        && d.todayDate is string
        && d.todayDate.size() == 10
        && d.todayDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.streak is int
        && d.streak >= 0
        && d.streak <= 3650
        && isValidCirclesList(d.circles)
        && d.updatedAt is timestamp
        && d.updatedAt == request.time
        && isValidOptionalActiveGame(d);
    }

    function isValidLeaderboardCreate(uid) {
      let d = request.resource.data;
      return isValidLeaderboardBase(uid)
        && d.totalPoints <= 15000
        && d.streak <= 90;
    }

    function isValidLeaderboardUpdate(uid) {
      let d = request.resource.data;
      return isValidLeaderboardBase(uid)
        && isDocOwner()
        && uidNotModified()
        && resource.data.uid == uid
        && d.totalPoints >= resource.data.totalPoints
        && d.totalPoints <= resource.data.totalPoints + 1000
        && d.streak <= resource.data.streak + 2;
    }

    // ===============================================================
    // Domain Validators: pushReminders (Used in BOTH create and update)
    // ===============================================================

    function isValidPushReminderBase(uid) {
      let d = request.resource.data;
      let keys = pushReminderKeys();
      return isOwner(uid)
        && uidUnchanged()
        && hasRequiredFields(keys)
        && hasOnlyAllowedFields(keys)
        && d.uid is string
        && d.uid.size() >= 1
        && d.uid.size() <= 128
        && d.uid == uid
        && d.enabled is bool
        && d.sealedSub is string
        && d.sealedSub.size() <= 1024
        && d.sealedSub.matches('^[A-Za-z0-9_-]*$')
        && (
          (d.enabled == true && d.sealedSub.size() >= 120 && d.sealedSub.size() <= 1024) ||
          (d.enabled == false && d.sealedSub == '')
        )
        && d.lang is string
        && d.lang.size() == 2
        && d.lang in ['zh', 'en']
        && d.region is string
        && d.region.size() >= 2
        && d.region.size() <= 4
        && d.region in ['hk', 'yvr', 'both']
        && d.reminderHour is int
        && d.reminderHour >= 0
        && d.reminderHour <= 23
        && d.lastDoneDate is string
        && (
          d.lastDoneDate.size() == 0 ||
          (d.lastDoneDate.size() == 10 && d.lastDoneDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        )
        && d.updatedAt is timestamp
        && d.updatedAt == request.time;
    }

    function isValidPushReminderCreate(uid) {
      return isValidPushReminderBase(uid);
    }

    function isValidPushReminderUpdate(uid) {
      return isValidPushReminderBase(uid)
        && isDocOwner()
        && uidNotModified()
        && resource.data.uid == uid;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /leaderboard/{uid} {
      // Public single-doc reads and quota-bounded list queries (max 100 docs per query)
      // to protect the Firebase Spark free-tier 50,000/day read quota against full-collection scans.
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 100;

      // Strict owner-only create & update with anti-cheat progression invariants.
      allow create: if isValidLeaderboardCreate(uid);
      allow update: if isValidLeaderboardUpdate(uid);

      // Disallow client deletes so players cannot delete-and-recreate docs to bypass update invariants.
      allow delete: if false;
    }

    match /pushReminders/{uid} {
      // Owner-only single-doc read; bounded list read (max 200) for scheduled E2E-encrypted Web Push dispatcher.
      allow get: if isOwner(uid);
      allow list: if request.query.limit != null && request.query.limit <= 200;

      // Strict owner-only create, update, and 1-tap opt-out delete.
      allow create: if isValidPushReminderCreate(uid);
      allow update: if isValidPushReminderUpdate(uid);
      allow delete: if isOwner(uid);
    }

    // Default deny all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
